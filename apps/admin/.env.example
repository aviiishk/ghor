# GHOR Admin Console — environment (copy to .env.local for development).
# This app never talks to PostgreSQL. It calls apps/api /admin/* server-side only.

# Base URL of apps/api as reachable FROM THIS SERVER (not from browsers).
ADMIN_API_URL=http://localhost:3000

# Shared with apps/api (BFF_PROXY_SECRET there): lets the API trust the real client IP
# this BFF forwards, for rate limits and audit metadata. Random, >= 32 chars in prod.
BFF_PROXY_SECRET=

# Which client IP to forward to the API (rate limits, audit metadata). NEVER the raw
# X-Forwarded-For. See lib/server/client-ip.ts. Unset = forward nothing (correct locally).
#   header:<name>  a header your platform edge sets and overwrites (e.g. header:x-vercel-forwarded-for)
#   xff:<n>        the n-th address from the right of X-Forwarded-For (n = trusted proxy hops)
# CLIENT_IP_SOURCE=

# production | staging | development — staging shows an amber environment banner.
NEXT_PUBLIC_ADMIN_ENV=development

# Deployment: production → admin.ghor.co.in, staging → admin-staging.ghor.co.in (D-47).
# The console's public browser origin(s), exact scheme://host[:port], comma-separated. The
# BFF refuses state-changing requests whose Origin is not listed (CSRF check that works
# behind a TLS-terminating proxy). No wildcards. Unset: localhost:3001 in development,
# nothing (all mutations refused) in production. apps/api's ADMIN_ALLOWED_ORIGINS must
# list the same origin(s).
#   production: ADMIN_ALLOWED_ORIGINS=https://admin.ghor.co.in
#   staging:    ADMIN_ALLOWED_ORIGINS=https://admin-staging.ghor.co.in
# ADMIN_ALLOWED_ORIGINS=
