# Postgres connection (still Supabase-hosted, connected to directly via Prisma, not
# supabase-js/PostgREST). Get both from the Supabase dashboard's "Connect" button -> ORM
# tab. Supabase's current pooler-only setup has no separate direct host, so both URLs
# point at the same pooler host, distinguished by port/mode — see
# prisma/schema.prisma's datasource block for how each is used.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<pooler-host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<pooler-host>:5432/postgres"

PORT=3000

# JWT signing — generate real random values before deploying anywhere real.
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="30d"

# Google OAuth (server-side token verification)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Bulk SMS API for phone OTP — founder-provided, see root CLAUDE.md §5/§12.
SMS_API_URL=""
SMS_API_KEY=""

# Cloudinary — unchanged from the old architecture, still used for listing photos.
# Signed listing-photo uploads (POST /uploads/signature). The secret stays server-side;
# the web app needs no Cloudinary env vars and no unsigned upload preset.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Expo push — sent directly from this API now (no more Supabase Edge Function trigger).
EXPO_ACCESS_TOKEN=""

# --- Admin console (apps/admin) — Phase 0, D-46/D-47 -------------------------------------
# Break-glass list (comma-separated E.164 phones). Used ONLY by the admin-console sign-in
# (POST /admin/auth/break-glass): an explicit, single-use, audited step that makes the
# account a super_admin, resets its authenticator (TOTP re-enrollment required), ends its
# other sessions and alerts every super_admin. Marketplace login no longer promotes anyone.
# Keep it to the bootstrap super admin; everyone else is added in the console.
ADMIN_PHONES=""

# Admin access tokens (aud=admin). Must differ from JWT_ACCESS_SECRET/JWT_REFRESH_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ADMIN_ACCESS_SECRET=
# AES-256-GCM key for TOTP secrets at rest: exactly 32 random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_TOTP_ENCRYPTION_KEY=
# Keyed hash for recovery codes (>= 32 chars, random).
ADMIN_RECOVERY_CODE_PEPPER=
# Keyed hash for IP addresses in audit rows (required in production).
IP_HASH_KEY=
# Shared with the web/admin BFFs so the API can trust the client IP they forward.
BFF_PROXY_SECRET=

# Browser origins. CORS_ALLOWED_ORIGINS = marketplace web (chat socket); ADMIN_ALLOWED_ORIGINS
# = admin console (https://admin.ghor.co.in, https://admin-staging.ghor.co.in). Both
# required in production; localhost defaults apply in development.
CORS_ALLOWED_ORIGINS=
ADMIN_ALLOWED_ORIGINS=

# Legacy apps/web /admin API (/legacy-admin/*): a temporary migration tool with NO TOTP.
# Off unless exactly "true" (fail closed). Production uses apps/admin; leave this false.
LEGACY_ADMIN_ENABLED=false
# false = this instance serves HTTP only (no auto-approval/outbox jobs). Jobs coordinate
# through Postgres leases, so running them on several instances is safe.
JOBS_ENABLED=true

# Geocoding for the map view (src/geocoding/). Defaults to OSM public Nominatim, whose
# usage policy allows <=1 req/s and requires an identifying User-Agent. Point GEOCODER_URL
# at a paid Nominatim-compatible provider (LocationIQ, MapTiler, self-hosted) before scale.
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=GHOR/1.0 (+https://ghor.co.in)
# GEOCODER_EMAIL=
# GEOCODER_ENABLED=true
