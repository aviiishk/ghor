GOOGLE_APPS_SCRIPT_URL=
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=

# apps/api base URL — server-side only, see lib/apiClient.ts + app/api/gateway.
API_URL=http://localhost:3000

# Same URL, browser-exposed — only the chat Socket.io connection uses this directly,
# everything else goes through /api/gateway. See lib/socket.ts.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Cloudinary — unsigned browser upload, same account as apps/mobile's
# EXPO_PUBLIC_CLOUDINARY_* pair.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ghor-listings

# Map view tiles (features/listings/components/ListingsMap.tsx). Unset = OSM public tiles,
# fine for dev but NOT allowed for heavy production use (OSM tile usage policy) — set a
# keyed provider URL (MapTiler, Stadia, ...) and its required attribution before launch.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
