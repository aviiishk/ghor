GOOGLE_APPS_SCRIPT_URL=
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=

# apps/api base URL — server-side only, see lib/apiClient.ts + app/api/gateway.
API_URL=http://localhost:3000

# Same URL, browser-exposed — only the chat Socket.io connection uses this directly,
# everything else goes through /api/gateway. See lib/socket.ts.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Cloudinary: nothing to set here. Listing photos use signed uploads — the API mints a
# signature (POST /uploads/signature) from CLOUDINARY_* in apps/api/.env, and the secret
# never reaches the browser. No unsigned upload preset is needed.

# Map view tiles (features/listings/components/ListingsMap.tsx). Unset = OSM public tiles,
# fine for dev but NOT allowed for heavy production use (OSM tile usage policy) — set a
# keyed provider URL (MapTiler, Stadia, ...) and its required attribution before launch.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors

# Legacy admin (/admin) — D-46. A temporary migration tool with no authenticator (TOTP)
# step. Off unless exactly "true" (fail closed): the pages redirect away and the API 404s
# /legacy-admin/*. To use it for migration/testing, set true here AND in apps/api.
# Production uses the separate admin console (apps/admin) — leave this unset or false.
LEGACY_ADMIN_ENABLED=false
